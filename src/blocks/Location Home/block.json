{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "datum/map-marker-section",
  "title": "Map Marker Section",
  "category": "datum",
  "description": "Hiển thị bản đồ với các marker theo thiết bị",
  "textdomain": "datum",
  "version": "0.1.0",
  "supports": {
    "html": false
  },
  "attributes": {
    "title": {
      "type": "string",
      "default": "locations.title"
    },
    "description": {
      "type": "string",
      "default": "locations.description"
    },
    "markers": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object"
      }
    },
    "markers_ipad": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object"
      }
    },
    "markers_mobile": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object"
      }
    }
  },
  "editorScript": "file:./index.tsx",
  "style": "file:./style.css",
  "editorStyle": "file:./editor.css",
  "render": "file:./render.php"
}
