{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "datum/join-revolution",
  "title": "Join the Revolution",
  "category": "datum",
  "description": "Block kêu gọi hành động với nội dung và nút CTA",
  "textdomain": "datum",
  "version": "1.0.0",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "viewStyle": "file:./style-index.css",
  "render": "file:./render.php",
  "supports": {
    "html": false
  },
  "attributes": {
    "title": {
      "type": "string",
      "default": "join_revolution.title"
    },
    "description": {
      "type": "string",
      "default": "join_revolution.description"
    },
    "bg_image": {
      "type": "string",
      "default": "images/why_datum_bg.png"
    },
    "cta_link": {
      "type": "string",
      "default": "/contact/"
    },
    "cta_text": {
      "type": "string",
      "default": "cta.schedule"
    }
  }
}
