{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "datum/info-image-list",
  "title": "Info with Image List",
  "category": "datum",
  "version": "1.0.0",
  "description": "Hiển thị danh sách nội dung và ảnh đi kèm, dịch qua key.",
  "textdomain": "datum",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "viewStyle": "file:./style-index.css",
  "render": "file:./render.php",
  "supports": {
    "html": false
  },
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    },
    "image_url": {
      "type": "string",
      "default": ""
    },
    "items": {
      "type": "array",
      "default": []
    }
  }
}
