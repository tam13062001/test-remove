{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "datum/info-section-with-image",
  "title": "Info Section with Image",
  "category": "datum",
  "description": "Block hiển thị tiêu đề, danh sách nội dung và ảnh minh họa bên phải.",
  "textdomain": "datum",
  "editorScript": "file:./index.tsx",
  "style": "file:./style.css",
  "editorStyle": "file:./editor.css",
  "render": "file:./render.php",
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    },
    "image_url": {
      "type": "string",
      "default": ""
    },
    "items": {
      "type": "array",
      "default": []
    }
  }
}
