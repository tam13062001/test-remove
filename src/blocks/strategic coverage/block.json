{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "datum/strategic-coverage",
  "title": "Strategic Coverage",
  "category": "datum",
  "description": "Block ảnh + tiêu đề + nội dung, cho phép sửa nội dung trực tiếp",
  "textdomain": "datum",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "render": "file:./render.php",
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    },
    "content": {
      "type": "string",
      "default": ""
    },
    "image_url": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false
  }
}
